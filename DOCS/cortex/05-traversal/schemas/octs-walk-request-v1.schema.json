{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector.dev/cortex/octs/walk-request/v1",
  "title": "OCTSWalkRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "walk_policy",
    "start_node_ids",
    "walk_execution_strategy",
    "exploration_mode"
  ],
  "anyOf": [
    { "required": ["temporal_anchor"] },
    { "required": ["inherit_walk_id"] }
  ],
  "properties": {
    "temporal_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "export_id",
        "export_sequence",
        "projection_content_hash",
        "snapshot_unix_ns",
        "graph_as_of_unix_ns"
      ],
      "properties": {
        "tenant_id": { "type": "string", "format": "uuid" },
        "export_id": { "type": "string", "format": "uuid" },
        "export_sequence": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "projection_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "snapshot_unix_ns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unix_ns"],
          "properties": { "unix_ns": { "type": "integer", "minimum": 0 } }
        },
        "graph_as_of_unix_ns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unix_ns"],
          "properties": { "unix_ns": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "walk_policy": { "type": "object" },
    "start_node_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "walk_execution_strategy": {
      "type": "string",
      "enum": ["ONLINE_OBSERVED", "MATERIALIZED_DERIVED", "HYBRID_PINNED"]
    },
    "exploration_mode": { "type": "boolean" },
    "pinned_index_epoch": { "type": "integer", "minimum": 0 },
    "inherit_walk_id": { "type": "string", "format": "uuid" },
    "expected_walk_result_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional strict replay pin (**WRJ**): must equal the source walk walk_result_hash."
    }
  }
}
