# Copy to `.env` at repo root. docker compose loads this file.
POSTGRES_USER=vector
POSTGRES_PASSWORD=vector
POSTGRES_DB=vector
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Browser → backend (published on host). Used by the Vite app in the browser.
VITE_API_BASE_URL=http://localhost:8000

# Backend CORS (comma-separated). Must include the Vite dev origin.
CORS_ORIGINS=http://localhost:5173

# From inside containers, DB host is the compose service name `postgres`.
DATABASE_URL=postgresql+psycopg://vector:vector@postgres:5432/vector

# Tests must use vector_test only (engineering-guidelines.md §7.3).
DATABASE_URL_TEST=postgresql+psycopg://vector:vector@postgres:5432/vector_test
