# =============================================================================
# Vector — root `.env` (Docker Compose + local tools)
# Copy to `.env` and adjust. Never commit `.env`.
# =============================================================================

# --- Postgres (compose + initdb) ---
POSTGRES_USER=vector
POSTGRES_PASSWORD=vector
POSTGRES_DB=vector
POSTGRES_PORT=5432

# --- Published ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Frontend (Vite; browser calls API on host) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Backend: redirects after OAuth / connectors ---
FRONTEND_URL=http://localhost:5173

# --- Session JWT (HS256). Must be long and random in production. ---
SECRET_KEY=replace-with-openssl-rand-hex-32-or-longer-dev-string!!!

# Optional overrides (defaults match vector/settings.py):
# SESSION_COOKIE_NAME=vector_session
# SESSION_TTL_SECONDS=604800
# OAUTH_STATE_COOKIE_NAME=vector_oauth

# --- Google OAuth (product sign-in). Leave empty to disable. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- GitHub App (connector: install + user OAuth). Leave empty until configured. ---
# API JWT `iss` uses GITHUB_CLIENT_ID (Iv…), per GitHub docs — not only the numeric App ID.
#
# Private key (recommended): save GitHub’s download as `./secrets/github_app.pem` (gitignored).
# Docker Compose mounts `./secrets` → `/run/secrets` on the backend.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave GITHUB_APP_PRIVATE_KEY empty when using the PEM file. Alternative: one-line PEM with \n.
# Host-only API (no Compose): use absolute path, e.g.
# GITHUB_APP_PRIVATE_KEY_PATH=/abs/path/to/vector/secrets/github_app.pem
# Must exactly match GitHub “User authorization callback URL” (use 127.0.0.1 if you register that).
GITHUB_USER_CALLBACK_URL=http://127.0.0.1:8000/connectors/github/callback
# If GITHUB_USER_CALLBACK_URL is empty, callback is {GITHUB_API_PUBLIC_BASE_URL}/connectors/github/callback
GITHUB_API_PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Linear (connector: OAuth `read` scope). Leave CLIENT_ID/SECRET empty until configured. ---
# Linear: Settings → API → New OAuth application (https://linear.app/settings/api/applications/new).
# - Enable "Public" if other workspaces should install your app; leave "Client credentials" OFF for user OAuth.
# - Add Redirect URL exactly equal to LINEAR_REDIRECT_URI below (or use the default if LINEAR_REDIRECT_URI is empty).
# Default callback if LINEAR_REDIRECT_URI is unset: {GITHUB_API_PUBLIC_BASE_URL}/connectors/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://127.0.0.1:8000/connectors/linear/callback

# --- CORS (comma-separated origins allowed to send cookies to the API) ---
CORS_ORIGINS=http://localhost:5173

# --- Database (inside Compose, host is service name `postgres`) ---
DATABASE_URL=postgresql+psycopg://vector:vector@postgres:5432/vector
# Tests / CI: same server, separate DB (see docker/postgres-init).
DATABASE_URL_TEST=postgresql+psycopg://vector:vector@postgres:5432/vector_test

# If you run the backend on the host instead of Docker, use for example:
# DATABASE_URL=postgresql+psycopg://vector:vector@127.0.0.1:5432/vector
# DATABASE_URL_TEST=postgresql+psycopg://vector:vector@127.0.0.1:5432/vector_test
# GITHUB_USER_CALLBACK_URL / VITE_API_BASE_URL should still match how you open the app.

# --- make seed-basic-tenant (dev only) ---
SEED_TENANT_SLUG=dev
SEED_USER_EMAIL=dev@vector.local
SEED_USER_PASSWORD=changeme
SEED_COMPANY_NAME=Development
