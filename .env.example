# Copy to `.env` at repo root. docker compose loads this file.
POSTGRES_USER=vector
POSTGRES_PASSWORD=vector
POSTGRES_DB=vector
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Browser → backend (published on host). Used by the Vite app in the browser.
VITE_API_BASE_URL=http://localhost:8000

# After Google OAuth, backend redirects the browser here.
FRONTEND_URL=http://localhost:5173

# Session cookie JWT signing (use a long random value in production).
SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32

# Google Cloud Console → OAuth 2.0 Client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Backend CORS (comma-separated). Must include the Vite dev origin.
CORS_ORIGINS=http://localhost:5173

# From inside containers, DB host is the compose service name `postgres`.
DATABASE_URL=postgresql+psycopg://vector:vector@postgres:5432/vector

# Tests must use vector_test only (engineering-guidelines.md §7.3).
DATABASE_URL_TEST=postgresql+psycopg://vector:vector@postgres:5432/vector_test

# Optional: `make seed-basic-tenant` — dev tenant + local user (skip if slug exists).
SEED_TENANT_SLUG=dev
SEED_USER_EMAIL=dev@vector.local
SEED_USER_PASSWORD=changeme
SEED_COMPANY_NAME=Development
