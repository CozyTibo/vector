# Copy to `.env` for local use. In AWS, set these on the ECS task, build job, etc.

# --- Required (production) ---
DATABASE_URL=postgresql+psycopg://user:password@your-rds-host:5432/vector
REDIS_URL=rediss://:auth-token@your-elasticache-host:6379/0
SECRET_KEY=generate-with-openssl-rand-hex-32
ENV=production

# --- Frontend build (Vite; inject at npm run build time) ---
# API origin only (no /admin/tenants/... suffix). For local `npm run dev`, use empty in
# frontend/.env.development (Vite proxy). Docker/host direct access: http://localhost:8000
VITE_API_BASE_URL=https://api.your-domain.com
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# --- HTTP / product URLs ---
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# --- Optional: local Docker Compose postgres ---
# POSTGRES_USER=vector
# POSTGRES_PASSWORD=vector
# POSTGRES_DB=vector
# POSTGRES_PORT=5432
# DATABASE_URL_TEST=postgresql+psycopg://vector:vector@postgres:5432/vector_test

# --- OAuth / connectors (set per environment) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_USER_CALLBACK_URL=
# GITHUB_API_PUBLIC_BASE_URL=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_REDIRECT_URI=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=   # defaults to <GITHUB_API_PUBLIC_BASE_URL>/connectors/notion/callback when empty
# NOTION_VERSION=2022-06-28
# CALLS_REDIRECT_URI=    # defaults to <GITHUB_API_PUBLIC_BASE_URL>/connectors/calls/callback when empty
# Calls OAuth reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET and requests calendar.readonly.
# Slack OAuth (https://api.slack.com/authentication/oauth-v2)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# Full URL must match Slack app Redirect URLs (e.g. ngrok): https://xxx.ngrok-free.dev/slack/callback
# SLACK_CALLBACK_URL=
# SLACK_BOT_SCOPES=channels:read,channels:history,channels:join,groups:read,groups:history,chat:write,im:history,im:write,users:read,usergroups:read
# Must match Slack app → OAuth & Permissions → Bot Token Scopes. channels:history + groups:history for message ingest.
# Re-connect Slack after changing scopes (existing tokens keep the old grant list).

# --- Local mock connectors (development ONLY; never enable in CI/staging/production) ---
# VECTOR_USE_MOCK_CONNECTORS=false
# VECTOR_MOCK_CONNECTOR_BASE_URL=http://127.0.0.1:9183
# VECTOR_MOCK_SEED=42
# When true: GitHub REST (poll sync) + Linear GraphQL hit the mock; GitHub user OAuth + App JWT GET installation
# and Linear OAuth (token + viewer/org) use production APIs (real).
# Docker Compose: repo `docker-compose.yml` starts `mock-connectors` and sets the API to http://mock-connectors:9183
# (overrides the line above in the backend container). Host-only API + mock: keep 127.0.0.1 and `make -f Makefile.mock mock-connectors-up`.
# Rare: API in Docker but mock on host — use http://host.docker.internal:9183 and avoid double-binding port 9183.

# --- Email (optional; requires Celery worker for queued sends) ---
# Configure SMTP + From — same code path for Mailtrap (dev) and Amazon SES SMTP (prod).
# Local: Mailtrap Email Testing → Integration → SMTP. Port 2525 or 587 + STARTTLS.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASSWORD=   # alias: SMTP_PASS
# SMTP_USE_TLS=true
# EMAIL_FROM_ADDRESS=vector@angelcorp.ai   # alias: EMAIL_FROM
# EMAIL_FROM_NAME=Vector
# SES_CONFIGURATION_SET=vector-prod-events  # optional; adds X-SES-CONFIGURATION-SET header on all SMTP sends
# Waitlist signup confirmation after /auth/register (requires Celery worker). Set false in pytest/CI
# so integration tests that register users do not hit real SMTP.
# VECTOR_WAITLIST_SIGNUP_EMAIL=true
# Email when an admin enables workspace access (waitlist → onboarding). Set false in pytest/CI.
# VECTOR_ONBOARDING_ACTIVATION_EMAIL=true
# Production (SES): create SMTP credentials in IAM; host is email-smtp.<region>.amazonaws.com (e.g.
# us-east-1), port 587, TLS on. Verify sending domain/address in SES first.

# --- Admin HTTP Basic (optional) ---
# ADMIN_PASSWORD=

# --- Cortex Phase 01 — ingestion routing (defaults ON; set false only to opt out / emergency) ---
# CORTEX_CONNECTOR_MIGRATION_ENABLED=true
# CORTEX_CONNECTOR_MIGRATION_CALLS=true
# CORTEX_CONNECTOR_MIGRATION_GITHUB=true
# CORTEX_CONNECTOR_MIGRATION_LINEAR=true
# CORTEX_CONNECTOR_MIGRATION_NOTION=true
# CORTEX_CONNECTOR_MIGRATION_SLACK=true
# Optional comma-separated tenant UUID allowlists (empty = all tenants):
# CORTEX_CONNECTOR_MIGRATION_GITHUB_TENANTS=

# --- Cortex Phase 01 Step 2–5 (scheduler, replay lane, post-sync verification) ---
# celery-worker queue list should include cortex_replay (see docker-compose.yml).
# CORTEX_INGESTION_SCHEDULER_ENABLED=false  # code default is false; set true in prod for Beat-driven syncs
# CORTEX_INGESTION_SCHEDULER_INTERVAL_SECONDS=1800
# CORTEX_INGESTION_MIN_GAP_SECONDS=120
# After a successful Cortex sync, run read-only Step 5 invariant checks (default true).
# CORTEX_INGESTION_VERIFY_AFTER_SYNC=true
# After each successful live incremental sync: canonical drain + identity refresh + Phase 05 graph export (vector queue).
# CORTEX_POST_INGESTION_SUBSTRATE_REFRESH_ENABLED=true
# CORTEX_POST_INGESTION_SUBSTRATE_REFRESH_DEBOUNCE_SECONDS=300
# CORTEX_POST_INGESTION_SUBSTRATE_REFRESH_MAX_WAIT_SECONDS=900
# CORTEX_POST_INGESTION_CANONICAL_BATCH_LIMIT=400
# Authoritative convergence runtime (Postgres lease + worker; replaces revoke/debounce coordinator)
# Post-ingestion substrate always uses convergence lease (M2; setting removed).
# CORTEX_CONVERGENCE_SWEEPER_ENABLED=true
# CORTEX_CONVERGENCE_SWEEPER_INTERVAL_SECONDS=120
# CORTEX_CONVERGENCE_SWEEPER_LIMIT=50
# CORTEX_CONVERGENCE_LEASE_TTL_SECONDS=900
# CORTEX_CONVERGENCE_TIME_BUDGET_SECONDS=540
# M3: legacy watchdog/progression beats removed from Celery beat (convergence sweep only).
# CORTEX_CANONICAL_FORWARD_PROGRESS_MAX_BATCHES_PER_SLICE=120
# CORTEX_CANONICAL_FORWARD_PROGRESS_ZERO_PROGRESS_BATCH_LIMIT=2
# CORTEX_CANONICAL_TOPOLOGY_WAIT_COOLDOWN_SECONDS=90
#
# --- Cortex Phase 01 organizational exhaust (depth caps; tune per environment) ---
# CORTEX_GITHUB_INSTALLATION_REPOS_MAX_PAGES=100
# CORTEX_GITHUB_PR_FETCH_MAX_REPOS=10
# CORTEX_GITHUB_PRS_PER_REPO=30
# CORTEX_SLACK_USERS_MAX_PAGES=50
# CORTEX_SLACK_CONVERSATIONS_MAX_PAGES=50
# CORTEX_SLACK_HISTORY_CHANNELS_PER_SYNC=12
# CORTEX_SLACK_CONVERSATIONS_HISTORY_LIMIT=1000
# CORTEX_SLACK_HISTORY_MAX_PAGES_PER_CHANNEL=30
# CORTEX_SLACK_CHANNEL_TIME_BUDGET_SECONDS=180
# CORTEX_LINEAR_ISSUES_FIRST=50
# CORTEX_NOTION_SEARCH_PAGE_SIZE=50
# CORTEX_NOTION_TIME_BUDGET_SECONDS=25
# CORTEX_CALLS_EVENTS_PAGE_SIZE=100
# CORTEX_CALLS_EVENTS_MAX_PAGES_PER_SYNC=8
# CORTEX_CALLS_TIME_BUDGET_SECONDS=25
#
# Phase 01 Step 6: operator pause for Beat enqueue (global). When REDIS_URL is set, POST
# /admin/cortex/ingestion/scheduler-pause writes Redis key ``vector:cortex_ingestion:scheduler_paused``.

# --- Celery (optional; defaults to REDIS_URL if unset) ---
# CELERY_RESULT_BACKEND=
# Local Docker Compose: use REDIS_URL=redis://redis:6379/0 (see docker-compose.yml).
# `docker compose` includes `celery-worker`.
