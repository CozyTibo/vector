{
  "family": "vector-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::884953290372:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::884953290372:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "884953290372.dkr.ecr.eu-west-1.amazonaws.com/vector-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ENV",
          "value": "production"
        },
        {
          "name": "CORTEX_GITHUB_PRS_MAX_PAGES_PER_REPO",
          "value": "10"
        },
        {
          "name": "CORTEX_GITHUB_PR_FETCH_MAX_REPOS",
          "value": "16"
        },
        {
          "name": "CORTEX_GITHUB_REPO_TIME_BUDGET_SECONDS",
          "value": "120"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vector-backend",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "backend",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
