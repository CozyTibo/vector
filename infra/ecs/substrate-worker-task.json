{
  "family": "vector-substrate-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::884953290372:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::884953290372:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "884953290372.dkr.ecr.eu-west-1.amazonaws.com/vector-worker:latest",
      "essential": true,
      "command": [
        "celery",
        "-A",
        "app.worker",
        "worker",
        "--loglevel=info",
        "--concurrency",
        "2",
        "--prefetch-multiplier=1",
        "-Q",
        "vector"
      ],
      "environment": [
        {
          "name": "ENV",
          "value": "production"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vector-backend-worker",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "worker",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "celery-beat",
      "image": "884953290372.dkr.ecr.eu-west-1.amazonaws.com/vector-worker:latest",
      "essential": true,
      "command": ["celery", "-A", "app.worker", "beat", "--loglevel", "info"],
      "environment": [
        {
          "name": "ENV",
          "value": "production"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vector-backend-worker",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "beat",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
