{
  "family": "vector-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::884953290372:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::884953290372:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "884953290372.dkr.ecr.eu-west-1.amazonaws.com/vector-worker:latest",
      "essential": true,
      "command": [
        "celery",
        "-A",
        "app.worker",
        "worker",
        "--loglevel=info"
      ],
      "environment": [
        {
          "name": "ENV",
          "value": "production"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vector-worker",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "worker",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
