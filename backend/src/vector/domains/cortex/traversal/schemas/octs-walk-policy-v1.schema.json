{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector.dev/cortex/octs/walk-policy/v1",
  "title": "OCTSWalkPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["max_hops", "tie_break", "hop_class_allowlist"],
  "properties": {
    "max_hops": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
    "max_frontier": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
    "max_wall_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "max_edges_visited": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
    "hop_class_allowlist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tie_break": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["fingerprint", "org_link_id", "lex_org_link_id"]
      }
    },
    "respect_validity": { "type": "boolean" },
    "diagnostics_only": { "type": "boolean" },
    "policy_version": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "undirected_mode": { "type": "boolean" },
    "skip_invalid_edges": { "type": "boolean" },
    "fast_path_allowed": { "type": "boolean" },
    "hybrid_switch_at_index_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  }
}
