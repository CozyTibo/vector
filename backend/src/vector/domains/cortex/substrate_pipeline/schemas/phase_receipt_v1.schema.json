{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector.dev/contracts/phase_receipt_v1.schema.json",
  "title": "substrate_phase_receipt",
  "type": "object",
  "required": [
    "schema_version",
    "phase_id",
    "tenant_id",
    "pipeline_run_id",
    "outcome",
    "receipt_hash",
    "deterministic_version"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "phase_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "pipeline_run_id": { "type": "string" },
    "outcome": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "COMPLETED_EMPTY",
        "BLOCKED",
        "WAITING_ASYNC",
        "FAILED",
        "SKIPPED_BY_POLICY"
      ]
    },
    "receipt_hash": { "type": "string", "minLength": 8 },
    "processed_count": { "type": "integer" },
    "blocked_reason": { "type": ["string", "null"] },
    "deterministic_version": { "const": "substrate_receipt_v1" },
    "detail": { "type": "object" }
  }
}
